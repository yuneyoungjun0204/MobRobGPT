# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ── 가상환경 (주의: boatattack_sim/env 는 패키지이므로 'env/' 는 무시하지 않음) ──
#   ★ Windows 는 대소문자를 구분하지 않아 'ENV/' 가 'boatattack_sim/env/' 까지 잡는다.
#     루트 한정('/ENV/')으로 좁혀야 env 패키지가 추적된다.
.venv/
venv/
/ENV/

# ── OS / 에디터 ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ── 시뮬/지휘관 생성물 (런타임 생성) ────────────────────
boatattack_sim/eval/_basemap_cache/    # OSM 타일 캐시
*.pt                                    # 정책 체크포인트
/logs/                                  # tools/gcs_bridge_control.py 사이드카 실행 로그

# ── 렌더/진단 출력물 ────────────────────────────────────
out.gif
*_shot.png
ui_layout.png
font_test.png
# 주의: 프로젝트 자산(MobRob_GPT.mp4, Screenshot.png)은 추적 유지 — 위 패턴에 안 걸림

# ── 비밀키 (커밋 방지) ──────────────────────────────────
.env
*.key

# ── 육지 마스크 캐시 (OSM 생성물이나 오프라인 운용에 필요한 앵커만 추적) ──
boatattack_sim/env/_terrain_cache/*
!boatattack_sim/env/_terrain_cache/land_*_34.62500_128.52000_*.npy

# ── 평가 산출물 ────────────────────────────────────────
#   원자료 CSV·표는 재생성 가능하므로 추적하지 않는다(run_eval.py).
#   단 논문에 실제로 들어가는 그림(논문_그래프/)은 추적한다 — 재현 환경 없이도 논문이 서야 한다.
results/

# ── OMC 런타임 상태 (세션·체크포인트·리플레이 — 워크트리마다 다르고 충돌만 낸다) ──
#   .omc/skills/** 만 예외: 프로젝트 스코프 스킬은 공유 자산이다.
.omc/
!.omc/skills/
!.omc/skills/**

# ── 측정 스크립트의 출력물 (docs/measure_reward_breakdown.py, diagrams/*.py 로 재생성) ──
/frames.json
/reward_breakdown.json

# ── 벤더 도구 (자체 .git 을 가진 외부 저장소 — 서브모듈로 만들지 않는다) ──
tools/PlotNeuralNet/

# ── 이미지 생성 중간 산출물 ──
*.quality_attempt_*.png

# ── LaTeX 빌드 부산물 (본문 .tex 와 결과 .pdf 만 추적) ──
#   ★ 전역 '*.log' 는 쓰지 않는다 — 30_model/*/train.log 등 추적 중인 학습 로그가 걸린다.
논문초안/*.aux
논문초안/*.log
논문초안/*.out
논문초안/*.synctex.gz
논문초안/*.fls
논문초안/*.fdb_latexmk

# ── LaTeX 빌드 부산물 추가 (tools/build_paper.sh 의 판별 임시 파일·BibTeX 부산물) ──
논문초안/_build_*
논문초안/*.spl
논문초안/*.bbl
논문초안/*.blg
